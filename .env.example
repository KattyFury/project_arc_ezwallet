# ─────────────────────────────────────────────────────────────
# EZwallet – environment variables (server-side)
#
# Local dev : copy this file to `.env.txt` and fill in the real values.
#             (`dev-server.js` reads `.env.txt`; that file is already in .gitignore)
# Production: set them in Cloudflare Pages → Settings → Environment variables.
#
# ⚠️ NEVER commit a real key to git.
# ─────────────────────────────────────────────────────────────

# Circle LIVE_API_KEY:... (mainnet) - User-Controlled Wallets AND swap (Stablecoin Kit). Server-side only.
# Get it at: https://console.circle.com  →  API Keys
# The code accepts either name: API_KEY (preferred) or CIRCLE_API_KEY.
API_KEY=

# Signs the email-code sign-in tokens (/api/auth → /api/session). Any long random string.
AUTH_SECRET=

# Resend (https://resend.com) – sends the 6-digit sign-in code and the security emails.
RESEND_API_KEY=

# CoinGecko Demo key (https://www.coingecko.com/en/api) – /api/prices (EURC, cirBTC); Binance is the backup.
COINGECKO_API=


# ─────────────────────────────────────────────────────────────
# NOT secrets – for reference:
#
# VITE_MOCK=1   → turn on MOCK MODE (fake wallet + fake balances, Circle bypassed).
#                 Already set in `.env.mock`, run it with: npm run mock
#
# Cloudflare KV binding (Pages → Settings → Bindings): EZ_SYNC – sign-in codes, contact backup, announcements.
#
# The public IDs live directly in the source (not secrets, safe to expose):
#   - Circle App ID, chain, token addresses: src/network.js
#   - Google OAuth CLIENT_ID (Google sign-in is hidden): src/circle.js
# ─────────────────────────────────────────────────────────────
